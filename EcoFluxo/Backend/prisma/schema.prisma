
generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "mysql"
}

model Usuario{
  id Int @id @default(autoincrement())
  nome String
  email String @unique
  senha String
  perfil Perfil @default(MORADOR)
  criadoEm DateTime @default(now())
}

model Ecoponto {
  id Int @id @default(autoincrement())
  nome String
  latitude String
  longitude String
  descricao String?
  cep String?
  logradouro String?
  numero String?
  bairro String?
  cidade String?
  uf String?
  nota String?
  criadoEm DateTime @default(now())
  lixeiras[]
  @@map("ecoponto")
}

model Lixeira {
  id Int @id @default(autoincrement())
  uuid_sensor String
  tipo Tipo
  volume_max Int
  nivel_cheio Int
  ecoponto_id Int
  criadoEm DateTime @default(now())
  ecoponto Ecoponto @relaction(fields:[ecoponto_id], references:[id], onDelete:Cascade) //Fazendo relacionamentos de chave primaria e estrangeira
  @@map("lixeiras")
}